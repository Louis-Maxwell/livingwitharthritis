# SECURITY: Repo source of truth for HTTP headers.
# Live Lovable/Cloudflare may still strip Netlify-style _headers until the host/CDN dashboard applies them.
# Keep this file aligned with index.html meta CSP (meta cannot set frame-ancestors).
# Long-term caching for hashed build assets (js/css get a content hash in Vite → safe to cache forever).
# Fixes the "Serve static assets with an efficient cache policy" Lighthouse warning.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/hero/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/openverse/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

# Canonical icon sources live in src/assets/icons/ and are emitted with a content
# hash under /assets/* (immutable). The copies below are fallbacks for clients
# that request the well-known paths without reading the HTML — update both in the
# same change. They stay short-lived so a stale mark can't stick around.
/favicon.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.png
  Content-Type: image/png
  Cache-Control: public, max-age=3600, must-revalidate

/apple-touch-icon.png
  Content-Type: image/png
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=3600, must-revalidate

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600, must-revalidate

/icons/*
  Cache-Control: public, max-age=3600, must-revalidate

# Lovable CDN-hosted assets are content-addressed (immutable UUID paths).
/__l5e/assets-v1/*
  Cache-Control: public, max-age=31536000, immutable

# Sitemaps, robots and LLM feeds: revalidated daily by crawlers.
/sitemap*.xml
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400
/llms*.txt
  Cache-Control: public, max-age=86400
/ai.txt
  Cache-Control: public, max-age=86400

# HTML: browsers always revalidate so new deploys show immediately.
# The CDN may keep a fresh copy for 60s but must NOT serve stale HTML after
# that: stale HTML references hashed chunks that a new publish has deleted,
# which is what produced blank screens after updates (see
# src/lib/chunkRecovery.ts for the client-side recovery).
# CSP matches index.html and adds frame-ancestors (HTTP header only; ignored in meta CSP).
/*
  Cache-Control: no-cache
  CDN-Cache-Control: public, s-maxage=60
  Cloudflare-CDN-Cache-Control: public, s-maxage=60
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.evarist.ai https://www.googletagmanager.com https://*.googletagmanager.com https://*.google-analytics.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; media-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://*.stripe.com https://formsubmit.co https://*.evarist.ai https://www.googletagmanager.com https://*.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.google.com https://*.g.doubleclick.net https://www.google.com; frame-src 'self' https://www.google.com https://www.google.co.uk https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
