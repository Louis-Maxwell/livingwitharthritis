# Cache hashed JS & CSS assets for 1 year (content-hash ensures safe immutable caching)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache public images for 1 week
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Cache favicon for 1 day
/favicon.ico
  Cache-Control: public, max-age=86400

# Cache sitemap and robots for 1 day
/sitemap.xml
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400

# HTML: no-cache (always revalidate so users get the latest app shell)
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
/
  Cache-Control: no-cache, no-store, must-revalidate
