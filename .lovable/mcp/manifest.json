{
  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://zrvcejlncpndjfyuvcrd.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "living-with-arthritis-mcp",
      "version": "0.1.0",
      "title": "Living With Arthritis UK"
    },
    "tools": [
      {
        "name": "search_blog_articles",
        "title": "Search blog articles",
        "description": "Search published Living With Arthritis UK blog articles by keyword in title, excerpt, or category. Returns up to 20 matching articles with title, slug, category, excerpt, and direct answer summary.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Keyword or phrase to search for."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "Max results to return (default 10)."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_blog_article",
        "title": "Get blog article",
        "description": "Fetch the full content of a published Living With Arthritis UK blog article by its slug. Returns title, author, review info, direct answer, and full markdown body.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "URL slug of the article, e.g. 'ginger-vs-turmeric-for-arthritis'."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_appointments",
        "title": "List my appointments",
        "description": "List the signed-in user's own Living With Arthritis UK appointments (virtual physiotherapy / consultation bookings), most recent first. Row-Level Security ensures only your own rows are returned.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max results (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_pain_journal_entries",
        "title": "List my pain journal entries",
        "description": "List the signed-in user's own pain journal entries, most recent first. Returns pain level (0–10), stiffness duration, joints affected, mood, sleep quality, and free-text notes. RLS ensures only your own entries are returned.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "description": "Max entries (default 30)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_pain_journal_entry",
        "title": "Create pain journal entry",
        "description": "Record a new pain journal entry for the signed-in user. Use this to log daily pain, stiffness, joints affected, mood, sleep, and notes. Writes to the caller's own row under RLS.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "entry_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date of the entry in YYYY-MM-DD (defaults to today if omitted)."
            },
            "pain_level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "description": "Overall pain 0 (none) – 10 (worst)."
            },
            "stiffness_duration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440,
              "description": "Morning stiffness duration in minutes."
            },
            "joints_affected": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40
              },
              "maxItems": 20,
              "description": "List of affected joints, e.g. ['left knee','right hand']."
            },
            "mood": {
              "type": "string",
              "maxLength": 80
            },
            "sleep_quality": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "description": "Sleep 0 (awful) – 10 (great)."
            },
            "activities": {
              "type": "string",
              "maxLength": 1000
            },
            "medications": {
              "type": "string",
              "maxLength": 1000
            },
            "triggers": {
              "type": "string",
              "maxLength": 1000
            },
            "notes": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "pain_level"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
