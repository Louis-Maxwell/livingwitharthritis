{
  "version": 1,
  "sdk_version": "2.0.4",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "living-with-arthritis",
      "version": "0.1.0",
      "title": "Living With Arthritis"
    },
    "tools": [
      {
        "name": "search_guides",
        "title": "Search arthritis guides",
        "description": "Search the published Living With Arthritis UK guides by keyword and return matching titles, summaries and links.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "description": "Keywords to search for, e.g. \"knee exercises\" or \"PIP benefits\"."
            },
            "limit": {
              "type": "integer",
              "description": "How many results to return (1-20). Defaults to 8."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_guide",
        "title": "Read an arthritis guide",
        "description": "Fetch the full readable text of one published Living With Arthritis UK guide, using the slug returned by search_guides.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "The guide slug, e.g. \"physiotherapy-arthritis\"."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_topics",
        "title": "List guide topics",
        "description": "List the topic categories covered by Living With Arthritis UK guides, with how many published guides each one has.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
