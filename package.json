{
  "name": "livingwitharthritis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Living With Arthritis — frontend built with Vite, React, TypeScript, and TailwindCSS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Louis-Maxwell/livingwitharthritis.git"
  },
  "author": "Louis-Maxwell",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "predev": "(bun scripts/generate-blog-catalog.ts && node scripts/generate-blog-head-data.mjs) || true; bun scripts/generate-sitemap.ts && node scripts/enrich-sitemap-images.mjs || true; node scripts/generate-llms-full.mjs || true",
    "dev": "vite",
    "prebuild": "bun scripts/generate-blog-catalog.ts && node scripts/generate-blog-head-data.mjs && node scripts/generate-search-index.mjs && bun scripts/generate-sitemap.ts && node scripts/enrich-sitemap-images.mjs && bun scripts/generate-condition-head-data.ts && bun scripts/generate-library-head-data.ts && bun scripts/generate-hub-guide-head-data.ts && node scripts/generate-llms-full.mjs && bun scripts/generate-og-images.ts && bun run seo:blog-guards",
    "build": "vite build",
    "postbuild": "node scripts/inject-canonicals.mjs && node scripts/generate-404.mjs && node scripts/write-redirect-html.mjs && node scripts/write-city-hub-html.mjs && (node scripts/indexnow-ping.mjs || true)",
    "og:generate": "bun scripts/generate-og-images.ts",
    "og:regenerate": "bun scripts/generate-og-images.ts --force",
    "aeo:apply": "node scripts/apply-aeo.mjs",
    "build:prerender": "PRERENDER=1 vite build",
    "postbuild:prerender": "node scripts/inject-canonicals.mjs && node scripts/generate-404.mjs && node scripts/write-redirect-html.mjs && node scripts/write-city-hub-html.mjs && (node scripts/indexnow-ping.mjs || true)",
    "build:dev": "vite build --mode development",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "links:check": "node scripts/check-internal-links.mjs",
    "preview": "vite preview",
    "sitemap": "bun scripts/generate-sitemap.ts && node scripts/enrich-sitemap-images.mjs",
    "llms-full": "node scripts/generate-llms-full.mjs",
    "seo:audit": "bun scripts/seo-audit.ts",
    "seo:schema": "node scripts/validate-jsonld.mjs",
    "seo:social": "node scripts/check-social-meta.mjs",
    "seo:meta-lengths": "bun scripts/audit-meta-lengths.ts",
    "seo:images": "bun scripts/audit-images.ts",
    "seo:blog-guards": "bunx vitest run src/lib/__tests__/blog-share-guards.test.ts src/lib/__tests__/blog-image-url-backfill.test.ts src/lib/__tests__/blog-head-social-meta.test.ts src/lib/__tests__/articleImages.unique-covers.test.ts",
    "seo:inventory": "node scripts/generate-seo-inventory.mjs",
    "seo:headings": "bun scripts/audit-headings.ts",
    "seo:aeo-sync": "bun scripts/check-aeo-sync.mjs",
    "seo:redirects": "node scripts/check-redirects.mjs && node scripts/sync-host-redirects.mjs --check",
    "seo:prerender-meta": "node scripts/check-prerender-meta.mjs",
    "seo:ai-identity": "node scripts/validate-ai-identity.mjs",
    "seo:sitemap-live": "node scripts/audit-sitemap.mjs",
    "css:check": "node scripts/check-css-utilities.mjs",
    "test:layout": "playwright test --config=tests/visual/playwright.config.ts",
    "test:layout:update": "playwright test --config=tests/visual/playwright.config.ts layout-snapshots --update-snapshots",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "fix:branded-search": "node scripts/fix-branded-search.mjs",
    "indexnow": "INDEXNOW=1 node scripts/indexnow-ping.mjs",
    "test": "vitest run && npm run test:dependency-security",
    "test:watch": "vitest",
    "search:index": "node scripts/generate-search-index.mjs",
    "blog:catalog": "bun scripts/generate-blog-catalog.ts",
    "blog:check": "bun scripts/generate-blog-catalog.ts --check",
    "blog:mark-reviewed": "node scripts/mark-blog-reviewed.mjs",
    "library:mark-reviewed": "node scripts/mark-library-reviewed.mjs",
    "blog:html-gate": "node scripts/check-blog-html.mjs",
    "test:blog-smoke": "playwright test e2e/blog-smoke.spec.ts",
    "test:route-smoke": "playwright test e2e/route-smoke.spec.ts",
    "test:a11y-smoke": "playwright test e2e/a11y-smoke.spec.ts",
    "seo:foundations": "node scripts/check-live-foundations.mjs",
    "test:dependency-security": "node --test scripts/test-braces-security.cjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "framer-motion": "^12.26.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.462.0",
    "marked": "^18.0.5",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^6.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-plugin-dev-server-bridge": "^1.0.2",
    "@lovable.dev/vite-plugin-hmr-gate": "^1.8.0",
    "@playwright/test": "^1.57.0",
    "@prerenderer/renderer-puppeteer": "^1.2.4",
    "@prerenderer/rollup-plugin": "^0.3.12",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.12.1",
    "braces": "file:vendor/braces",
    "drizzle-kit": "0.x",
    "drizzle-orm": "0.x",
    "esbuild": "^0.25.12",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "lovable-tagger": "^1.1.9",
    "picomatch": "^4.0.5",
    "postcss": "^8.5.19",
    "postgres": "^3.4.9",
    "puppeteer": "^25.8.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "satori": "^0.26.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "minimatch": "^10.2.6",
    "glob": "^10.4.5",
    "flatted": "^3.3.2",
    "form-data": "^4.0.4",
    "ws": "^8.18.0",
    "rollup": "^4.24.4",
    "vite": "^6.4.3",
    "marked": "^18.0.5",
    "@remix-run/router": "^1.23.0",
    "react-router": "^7.18.3",
    "react-router-dom": "^7.18.3",
    "dompurify": "^3.4.15",
    "jspdf": "^4.2.1",
    "picomatch": "^4.0.5",
    "lodash": "^4.17.21",
    "ts-deepmerge": "^8.0.0",
    "esbuild": "^0.25.12",
    "qs": "^6.16.0",
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.3.2",
    "braces": "$braces",
    "postcss-selector-parser": "^7.1.6"
  },
  "resolutions": {
    "minimatch": "^10.2.6",
    "glob": "^10.4.5",
    "flatted": "^3.3.2",
    "form-data": "^4.0.4",
    "ws": "^8.18.0",
    "rollup": "^4.24.4",
    "marked": "^18.0.5",
    "@remix-run/router": "^1.23.0",
    "dompurify": "^3.4.15",
    "jspdf": "^4.2.1",
    "picomatch": "^4.0.5",
    "lodash": "^4.17.21",
    "brace-expansion": "^5.0.1",
    "braces": "file:vendor/braces",
    "postcss-selector-parser": "^7.1.6"
  }
}
