# ============================================
# SAMPLE .env.local FILE
# ============================================
# 
# IMPORTANT: 
# 1. Create this file as .env.local (not .env.local.sample)
# 2. Fill in your real values
# 3. NEVER commit it to GitHub
# 4. Add .env.local to .gitignore
#
# This sample shows what it should look like with your values:
#

# ============================================
# Supabase Configuration (Your Project)
# ============================================

VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_URL=https://your_supabase_project_id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here


# ============================================
# Google Analytics 4 (Your Project)
# ============================================

VITE_GA4_PRIMARY_ID=G-YOUR_PRIMARY_ID
VITE_GA4_SECONDARY_ID=G-YOUR_SECONDARY_ID
VITE_GA4_PAGEVIEW_ID=G-YOUR_PAGEVIEW_ID


# ============================================
# Optional: Payment Processors
# ============================================

# VITE_PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
# VITE_STRIPE_PUBLIC_KEY=pk_test_YOUR_STRIPE_KEY


# ============================================
# Optional: Email Service
# ============================================

# VITE_RESEND_API_KEY=re_YOUR_RESEND_KEY


# IMPORTANT REMINDERS:
# - This file contains sensitive credentials
# - It is LOCAL ONLY — never push to GitHub
# - If you accidentally commit it, rotate all keys immediately
# - For production, set these in your deployment platform's environment variables
