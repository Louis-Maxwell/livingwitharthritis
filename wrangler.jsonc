{
  // Static-asset hosting config (Cloudflare Workers static assets).
  //
  // The site is prerendered: every indexable route has its own real file in
  // ./dist with a unique <title>, <h1> and self-referencing canonical.
  // Therefore the host must NOT run in single-page-application mode — that
  // mode answers every unknown path with index.html and HTTP 200, which is
  // exactly the soft-404 problem (unknown URLs inheriting the homepage
  // title/canonical/OG tags).
  //
  // "404-page" makes the host serve the nearest 404.html with a real HTTP 404
  // status when no file matches. dist/404.html is emitted by
  // scripts/generate-404.mjs (noindex, unique title, no homepage metadata).
  //
  // App-only routes that are never prerendered (/admin, /auth, /dashboard,
  // /checkout, /callback, /account, /donation-result, /debug) still get the
  // SPA shell with a 200 via explicit rewrite rules in dist/_redirects, which
  // are evaluated before the not-found handling. Alias 301s
  // (/about-us -> /about, /trust-credibility -> /trust) sit at the top of
  // public/_redirects, first match wins.
  "name": "living-with-arthritis",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
