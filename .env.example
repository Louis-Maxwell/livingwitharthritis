# Environment variables template
# Copy to .env.local for local Vite development. Never commit .env.local.
#
# Forms use mailto; chat is local canned answers; search is client-side.
# Deploy: push to main and publish via Lovable / static host.

# --- Frontend (Vite) ---
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

VITE_GA4_PRIMARY_ID=
VITE_GA4_SECONDARY_ID=
VITE_GA4_PAGEVIEW_ID=

VITE_PAYPAL_CLIENT_ID=
VITE_STRIPE_PUBLIC_KEY=
VITE_STRIPE_DONATE_URL=

VITE_SHOPIFY_STOREFRONT_TOKEN=

# Optional IndexNow key for scripts/indexnow-ping.mjs (HTTP ping)
# INDEXNOW_KEY=

# Optional Bing Webmaster Tools verification (msvalidate.01 meta).
# Paste Louis's code from Bing Webmaster → only when you have a real token.
# VITE_BING_SITE_VERIFICATION=

# Optional Google Business Profile Maps embed URL (Contact page iframe).
# Must be an https://www.google.com/maps/embed... URL. Leave unset until GBP is verified.
# Never invent a Place ID or street address (no Oswestry).
# VITE_GBP_MAPS_EMBED_URL=

