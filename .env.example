# ============================================
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# 
# Copy this file to .env.local and fill in your actual values.
# IMPORTANT: NEVER commit .env.local to GitHub
# 
# This template shows what env vars your app needs.
# In production, set these in your deployment platform:
# - Lovable: Project Settings > Environment Variables
# - Netlify: Site settings > Build & deploy > Environment
# - Vercel: Project settings > Environment Variables
#

# ============================================
# Supabase Configuration
# ============================================
# Get these from: https://app.supabase.com > Project Settings > API

VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# For backend functions and migrations (optional, but recommended for production)
# Use connection pooling URL for web/serverless functions, regular URL for migrations
DATABASE_URL=postgresql://postgres:[password]@[project-ref].pooling.supabase.co:6543/postgres

# ============================================
# Edge Function Rate Limiting (server-side)
# ============================================
# Set with `supabase secrets set`; never prefix these with VITE_.
# Production must use redis. Local development may use memory.

RATE_LIMIT_STORE=redis
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
RATE_LIMIT_KEY_SALT=
RATE_LIMIT_TRUST_PROXY_HOPS=1

RATE_LIMIT_AUTH_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_CONTACT_REQUESTS=3
RATE_LIMIT_CONTACT_WINDOW_SECONDS=60
RATE_LIMIT_SEARCH_REQUESTS=30
RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_GENERAL_REQUESTS=100
RATE_LIMIT_GENERAL_WINDOW_SECONDS=900


# ============================================
# Error Tracking
# ============================================
# Sentry: https://sentry.io > Settings > Client Keys (DSN)
VITE_SENTRY_DSN=

# Sentry Source Maps (for production builds only)
# Get these from: https://sentry.io > Settings > Auth Tokens
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=


# ============================================
# Google Analytics 4
# ============================================
# Get these from: https://analytics.google.com > Admin > Data Streams

VITE_GA4_PRIMARY_ID=
VITE_GA4_SECONDARY_ID=
VITE_GA4_PAGEVIEW_ID=


# ============================================
# E-Commerce (Optional)
# ============================================

# Shopify Storefront API: https://admin.shopify.com > Apps & integrations > Develop apps
VITE_SHOPIFY_STOREFRONT_TOKEN=

# PayPal: https://developer.paypal.com/dashboard
VITE_PAYPAL_CLIENT_ID=

# Stripe: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLIC_KEY=


# ============================================
# Email Service (Optional)
# ============================================

# Resend: https://resend.com/api-keys
VITE_RESEND_API_KEY=


# ============================================
# API Keys (Optional)
# ============================================

# Add any other API keys your app needs
# Format: VITE_[SERVICE_NAME]_KEY=your-key-here
