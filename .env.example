# Environment variables template
# Copy to .env.local for local Vite development. Never commit .env.local.
#
# Production Worker secrets are set with Wrangler (not VITE_*):
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put OPENAI_API_KEY   # optional if Workers AI binding is enough
#   npx wrangler secret put RESEND_FROM     # optional verified From address
#   npx wrangler secret put CONTACT_TO_EMAIL  # optional; default info@livingwitharthritis.org.uk
#
# Deploy:
#   npm run build && npx wrangler deploy
# Live DNS may still point at Lovable until Cloudflare is cut over.

# --- Frontend (Vite) ---
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

VITE_GA4_PRIMARY_ID=
VITE_GA4_SECONDARY_ID=
VITE_GA4_PAGEVIEW_ID=

VITE_PAYPAL_CLIENT_ID=
VITE_STRIPE_PUBLIC_KEY=
VITE_STRIPE_DONATE_URL=

VITE_SHOPIFY_STOREFRONT_TOKEN=

# Legacy browser-only Resend key (prefer Worker secret RESEND_API_KEY instead)
# VITE_RESEND_API_KEY=

# --- Cloudflare Worker secrets (set via wrangler secret put, not Vite) ---
# RESEND_API_KEY=
# RESEND_FROM=Living With Arthritis <forms@livingwitharthritis.org.uk>
# CONTACT_TO_EMAIL=info@livingwitharthritis.org.uk
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
