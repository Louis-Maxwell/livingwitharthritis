# Environment variables template
# Copy to .env.local for local Vite development. Never commit .env.local.
#
# No Cloudflare Worker / Wrangler API backend.
# Forms use mailto; chat is local canned answers; search is client-side.
# Deploy: push to main and publish via Lovable.

# --- Frontend (Vite) ---
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

VITE_GA4_PRIMARY_ID=
VITE_GA4_SECONDARY_ID=
VITE_GA4_PAGEVIEW_ID=

VITE_PAYPAL_CLIENT_ID=
VITE_STRIPE_PUBLIC_KEY=
VITE_STRIPE_DONATE_URL=

VITE_SHOPIFY_STOREFRONT_TOKEN=

# Optional IndexNow key for scripts/indexnow-ping.mjs (HTTP ping, not a Worker)
# INDEXNOW_KEY=
